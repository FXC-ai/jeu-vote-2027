FROM node:24-trixie-slim AS frontend-build

WORKDIR /app

COPY php-fpm/app/package.json php-fpm/app/package-lock.json ./
RUN npm ci

COPY php-fpm/app/ ./
RUN npm run build

FROM php:8.4-fpm-trixie AS php-runtime

ARG WWW_USER=1000
ARG WWW_GROUP=1000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y libpq-dev git unzip \
    && docker-php-ext-install pdo pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN groupadd --gid "${WWW_GROUP}" webapp \
    && useradd \
        --uid "${WWW_USER}" \
        --gid "${WWW_GROUP}" \
        --create-home \
        --shell /bin/bash \
        webapp

COPY --chown=webapp:webapp php-fpm/app/ /app/
COPY --chown=webapp:webapp --from=frontend-build \
    /app/public/build/ /app/public/build/

COPY --chmod=755 php-fpm/entrypoint.sh /usr/local/bin/entrypoint.sh

USER webapp

ENV COMPOSER_HOME=/home/webapp/.composer
ENV PATH="${COMPOSER_HOME}/vendor/bin:${PATH}"

RUN composer install \
    --no-dev \
    --prefer-dist \
    --optimize-autoloader \
    --no-interaction

FROM nginx:stable-alpine AS nginx-runtime

COPY nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/public/ /app/public/